graphify-out/

# Local operator
.ignorelocal/
/.claude/
/.cursor/
CLAUDE.md

# Sanitizing fetcher quarantine (github-issue-triage fetch_issue_safe.py).
# Do NOT remove — fetch_issue_safe.py writes raw blocked payloads here, and the
# .llmignore/blocked/ tree must stay local-only.
.llmignore/

# Analyzer adapter test artifacts
tests/analyzers/fixtures/repo/.mergecraft/

# TS5 adversarial corpus (built via tests/security/fixtures/build_hostile_repo.sh)
tests/security/fixtures/hostile-repo/
tests/security/fixtures/outside-target/

# Docker agent CLI installs (local npm deps for image build)
docker/agent-clis/node_modules/

# Local repo-native analyzer CLIs (#427)
tools/node_modules/

# Regenerable verifier/tool output (never source of truth)
/evidence/

# Ephemeral local convergence replay artifacts (not baselines)
evals/results/structural-replay-convergence-*.json

# Sibling wave worktrees that sometimes land nested inside the primary
# checkout instead of alongside it (backstop; operator removes them with
# `git worktree remove`, this just keeps them out of `git status`/`find`).
/mergecraft-*/

# Isolated git worktrees (local operator checkouts)
.worktrees/

# mergeCraft's own runtime cache/scratch state, provisioned into <repo>/.mergecraft/
# on every self-review run (analyzer-cache/, analyzer-scratch/, analyzer-runs/,
# analyzers.lock, .provision.lock, traces/) — regenerated every run, never source
# of truth. Without this it shows up as untracked and dirties the working tree on
# every self-review, which can also trip checkout_pr's clean-tree guard
# (src/mergecraft/mcp/checkout.py) on a second checkout in the same job. Repo-authored
# content under .mergecraft/ stays tracked via the negations below.
/.mergecraft/*
!/.mergecraft/config.yaml
!/.mergecraft/learnings.md
!/.mergecraft/xrepo-learnings.md
!/.mergecraft/xrepo-brief.md

/.agents

# Local wave agent kit (operator tooling)
/.github/agents/wave-plan-executor.md
/.github/agents/test-creator.md
/docs/_standards/invariants.md
