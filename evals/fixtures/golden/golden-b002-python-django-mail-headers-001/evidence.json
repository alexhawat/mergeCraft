  "buggy_commit_sha": "da82939e5a31dea21a4f4d5085dfcd449fcbed3a",
  "buggy_source_url": "https://github.com/django/django/blob/da82939e5a31dea21a4f4d5085dfcd449fcbed3a/django/core/mail/message.py#L273-L276",
  "proposed_label": {
    "category": "correctness",
    "status": "agent_proposal_only",
    "rationale": "With non-empty to recipients and headers={\"To\": \"mailing-list@example.com\"}, the new list-header helper writes To from extra_headers, then the final extra_headers loop writes it again because the introducing change stops skipping To. Python email.Message assignment appends headers. The fix skips already-handled list headers and changes tests to get_all() so duplicates become visible."
  },
  "rationale": "With non-empty to recipients and headers={\"To\": \"mailing-list@example.com\"}, the new list-header helper writes To from extra_headers, then the final extra_headers loop writes it again because the introducing change stops skipping To. Python email.Message assignment appends headers. The fix skips already-handled list headers and changes tests to get_all() so duplicates become visible.",
  "fix_test": {
    "path": "tests/mail/tests.py",
    "names": [
      "test_to_header",
      "test_cc_headers",
      "test_reply_to_header"
    ],
    "description": "The fix replaces single-header comparisons with message.get_all(\"To\"), get_all(\"Cc\"), and get_all(\"Reply-To\") equality against one-element lists. test_to_header covers the To duplication newly introduced by #9454.",
    "execution": "Upstream regression tests included, not run here."
  },
