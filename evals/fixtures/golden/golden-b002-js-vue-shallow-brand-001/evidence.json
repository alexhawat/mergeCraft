  "proposed_label": {
    "kind": "bug",
    "status": "agent-proposed; pending human adjudication",
    "rationale": "Changing the optional unique-symbol marker into a required property of type never makes a structurally equivalent plain object unassignable. No public caller can provide the uninhabitable required brand. The fix replaces it with an optional private-class brand; the added assignment test exercises this exact source compatibility regression."
  },
  "trigger": "Create const shallow = shallowReactive({ a: 1, b: 2 }); declare let values: typeof shallow; then assign values = { a: 1, b: 2 }.",
  "fix_explanation": "Use a private class with an optional private property as the brand, preserving distinction for unwrap types without requiring a symbol property for plain assignment.",
  "fix_test": {
    "description": "packages-private/dts-test/reactivity.test-d.ts: shallowReactive type should accept plain object assignment",
    "included": true,
    "locally_run": false,
