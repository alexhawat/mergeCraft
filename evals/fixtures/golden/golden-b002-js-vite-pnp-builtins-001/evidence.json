  "proposed_label": {
    "kind": "bug",
    "status": "agent-proposed; pending human adjudication",
    "rationale": "The new PnP resolution path calls resolveToUnqualified without considerBuiltins:false. The default treats names shared with Node builtins as builtin modules and returns no package location instead of resolving the installed browser-polyfill package; Vite then reports missing package metadata. The upstream fix explicitly disables builtin treatment in this package-only lookup."
  },
  "trigger": "In a Yarn Plug\u2019n\u2019Play project, resolve installed browser packages named buffer or string_decoder through Vite package metadata lookup.",
  "fix_explanation": "Pass { considerBuiltins: false } to pnp.resolveToUnqualified so installed packages sharing Node builtin names resolve as packages.",
  "fix_test": {
    "description": "No regression test was added in fix PR #12903; upstream fix body identifies installed buffer and string_decoder as failing inputs and links issue #12888.",
    "included": false,
    "locally_run": false
  },
  "caveats": [
    "No new upstream regression test in the fix PR; evidence consists of the explicit upstream causal statement, introducing call, and targeted option fix.",
