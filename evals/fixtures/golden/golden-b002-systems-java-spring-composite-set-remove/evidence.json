  "proposed_label": "bug",
  "proposed_category": "correctness",
  "rationale": "The introduced short-circuit OR skips removing the element from the second collection after the first removal succeeds. CompositeSet inherits this behavior and backs CompositeMap.keySet(); deleting an overlapping key therefore reveals the previously hidden second-map entry instead of removing the mapping. The fix overrides set removal to evaluate removals against both sets.",
  "fix_test": {
    "names": [
      "CompositeMapTests.CollisionTests.keySetRemove"
    ],
    "path": "spring-core/src/test/java/org/springframework/util/CompositeMapTests.java",
    "inspection": "Regression test additions and corresponding production fix inspected in merged upstream PR.",
    "local_execution": "not run"
  },
  "caveats": [
