# mergeCraft local environment example (generated — do not edit by hand).
#
# Regenerate with `make docs`; `scripts/gen_env_example.py` builds this file from
# the provider catalog and the environment-variable table in docs/cli.md.
#
# Every line is a commented variable name with no value, so `cp .env.example .env`
# changes nothing until you uncomment a line and fill it in. `.env` is gitignored:
# never commit it, and never paste real values into chat, logs or a commit message.
#
# The easy path is `mergecraft provider auth <label> --scope local`, which writes
# the indexed `LLM_PROVIDER_<N>_*` layout below for you. In GitHub Actions the same
# names come from `secrets.*` in your workflow, not from this file.
#
# Build provenance: MERGECRAFT_BUILD_COMMIT is supplied by build/runtime tooling.
# Version bootstrap checks that process value, then baked metadata, then Git.
# The existing build_commit compatibility alias is used only when the uppercase
# value is unset or empty. Values are stripped; whitespace means no override.
# This bootstrap read does not load .env; do not add either value here.

# ---------------------------------------------------------------------------
# Flat provider credentials (read by the matching harness)
# ---------------------------------------------------------------------------

# Anthropic (`anthropic`)
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Amazon Bedrock (`bedrock`)
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=
# BEDROCK_MODEL_ID=

# DeepSeek (`deepseek`)
# DEEPSEEK_API_KEY=

# Google (`google`)
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Moonshot AI (`moonshotai`)
# MOONSHOT_API_KEY=

# OpenAI (`openai`)
# OPENAI_API_KEY=
# CODEX_AUTH_JSON=

# OpenCode (`opencode`)
# OPENCODE_API_KEY=
# OPENCODE_AUTH_JSON=

# OpenCode Go (`opencode-go`)
# OPENCODE_GO_API_KEY=

# OpenRouter (`openrouter`)
# OPENROUTER_API_KEY=

# Tencent TokenHub (`tokenhub`)
# TOKENHUB_API_KEY=

# Google Vertex AI (`vertex`)
# VERTEX_SERVICE_ACCOUNT_JSON=
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=
# VERTEX_MODEL_ID=

# xAI (`xai`)
# XAI_API_KEY=

# ---------------------------------------------------------------------------
# Indexed provider layout (what `provider auth` writes)
# ---------------------------------------------------------------------------
# `LLM_PROVIDER_<N>` holds a provider label from `mergecraft provider list`; the
# credential for that provider is `LLM_PROVIDER_<N>_<SUFFIX>` with the same <N>.
# SUFFIX is API_KEY, CLAUDE_CODE_OAUTH_TOKEN, CODEX_AUTH_JSON, OPENCODE_AUTH_JSON,
# or the cloud credential names. Prefer this layout over the flat names below.
# LLM_PROVIDER_1=
# LLM_PROVIDER_1_API_KEY=

# ---------------------------------------------------------------------------
# Custom OpenAI-compatible provider (docs/authentication.md)
# ---------------------------------------------------------------------------
# MERGECRAFT_CUSTOM_PROVIDER_BASE_URL=
# MERGECRAFT_CUSTOM_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Operator knobs (docs/cli.md, Environment variables)
# ---------------------------------------------------------------------------
# Explicit agent harness (`claude`, `codex`, `opencode`, `gemini`, `cursor`);
# an unknown value falls through to auto-selection
# Default: unset — auto-select from credentials and model
# MERGECRAFT_AGENT=

# Seconds before an agent subprocess is killed
# Default: `3600`
# MERGECRAFT_AGENT_TIMEOUT=

# Run-cache root directory
# Default: `~/.cache/mergecraft/run-cache` (honours `XDG_CACHE_HOME`)
# MERGECRAFT_CACHE_DIR=

# Byte ceiling for the run cache, in bytes
# Default: `536870912` (512 MiB)
# MERGECRAFT_CACHE_MAX_BYTES=

# Opt-in verifier-verdict capture; `1` appends one redacted line per verdict
# (including dropped findings) to `judge-verdicts.jsonl` in the run's
# evidence directory
# Default: unset — capture off
# MERGECRAFT_CAPTURE_VERDICTS=

# Chrome DevTools Protocol base URL for the browser driver
# Default: `http://127.0.0.1:9222`
# MERGECRAFT_CDP_URL=

# Explicit path to the repo config file
# Default: unset — discovered at `<repo>/.mergecraft/config.yaml`
# MERGECRAFT_CONFIG=

# Seconds allowed for one context-retrieval call
# Default: `30`
# MERGECRAFT_CONTEXT_RETRIEVAL_TIMEOUT_S=

# Per-run spend ceiling, in US dollars
# Default: `50.0`
# MERGECRAFT_COST_BUDGET_USD=

# Comma-separated IPv4 resolvers allowed inside the analyzer network
# namespace
# Default: host `/etc/resolv.conf` nameservers (fallback `1.1.1.1`)
# MERGECRAFT_EGRESS_DNS_RESOLVERS=

# Explicit path to the `.env` file loaded at CLI startup
# Default: unset — git-root `.env`, skipped inside GitHub Actions
# MERGECRAFT_ENV=

# Parent directory for the emitted evidence packet and the captured
# `judge-verdicts.jsonl`
# Default: unset — `$RUNNER_TEMP/mergecraft`, else the run temp dir
# MERGECRAFT_EVIDENCE_DIR=

# Upper bound, in seconds, applied to every registered external operation
# Default: `600`
# MERGECRAFT_EXTERNAL_OPERATION_TIMEOUT_S=

# Any non-empty value keeps all of the offline review's
# `mergecraft-diff-review-*` temp directory, including the scratch
# (materialized diff, prompts, agent home)
# Default: unset — the scratch is removed when the process exits; the
# `evidence/` subdirectory (evidence packet, Jev shadow log,
# `--capture-verdicts` output) and `jev-shadow.jsonl` are kept
# MERGECRAFT_KEEP_TMP=

# Log sink format: `json` or `text`
# Default: `text`
# MERGECRAFT_LOG_FORMAT=

# Loguru level name (`TRACE` through `CRITICAL`)
# Default: unset — `INFO`, or `DEBUG` under `ACTIONS_STEP_DEBUG` /
# `--verbose`
# MERGECRAFT_LOG_LEVEL=

# Diff line ceiling before scope reduction is recorded
# Default: `50000`
# MERGECRAFT_MAX_DIFF_LINES=

# Model slug override; wins over the config `models:` list
# Default: unset — the first configured model
# MERGECRAFT_MODEL=

# Default `provider/model` slug for `mergecraft.agents_sdk.review_agent` when
# using the optional `[agents]` extra
# Default: unset — `gpt-4o-mini` with `OPENAI_API_KEY`, or
# `opencode-go/deepseek-v4.1-flash` with `OPENCODE_GO_API_KEY`
# MERGECRAFT_AGENTS_SDK_MODEL=

# Truthy disables interactive prompts
# Default: unset — prompts when stdin is a TTY
# MERGECRAFT_NONINTERACTIVE=

# Package path or spec of
# [opencode-plugin-otel-v2](https://github.com/alexhawat/opencode-plugin-otel-v2);
# when set and tracing exports to `otel` or `logfire`, OpenCode 2.x runs emit
# per-LLM-step and per-tool spans into the review's trace
# Default: unset — not loaded
# MERGECRAFT_OPENCODE_OTEL_PLUGIN=

# OTLP/HTTP endpoint for the `otel` tracing sink; setting it implies OTLP
# when no destination is chosen
# Default: unset
# MERGECRAFT_OTEL_ENDPOINT=

# Whole-run wall-clock ceiling, in seconds
# Default: `3600`
# MERGECRAFT_RUN_TIMEOUT_S=

# Run temp directory override
# Default: unset — the run's own temp dir, else `/tmp`
# MERGECRAFT_TEMP_DIR=

# Preferred parent directory for created temp dirs (avoids world-writable
# `/tmp`)
# Default: unset — `$RUNNER_TEMP`, else `~/.cache/mergecraft/tmp`
# MERGECRAFT_TEMP_PARENT=

# Per-run token ceiling
# Default: `2000000`
# MERGECRAFT_TOKEN_BUDGET=

# Per-run tool-call ceiling
# Default: `500`
# MERGECRAFT_TOOL_CALL_BUDGET=

# Directory for local JSONL traces
# Default: `.mergecraft/traces`
# MERGECRAFT_TRACE_DIR=

# Boolean toggle for tracing
# Default: unset — disabled unless config enables it
# MERGECRAFT_TRACING=

# Payload capture level: `off`, `metadata`, `redacted`, or `full`
# Default: `redacted`
# MERGECRAFT_TRACING_CONTENT=

# Logfire project label written alongside the Logfire write token
# Default: unset
# MERGECRAFT_TRACING_PROJECT=

# Logfire OTLP region: `us` or `eu`
# Default: `us`
# MERGECRAFT_TRACING_REGION=

# Tracing destination: `local_files`, `otel`, or `logfire`
# Default: unset — JSONL file sink when tracing is on
# MERGECRAFT_TRACING_TO=

# ---------------------------------------------------------------------------
# Logfire tracing token (written by `mergecraft auth logfire`; docs/TRACING.md)
# ---------------------------------------------------------------------------
# MERGECRAFT_LOGFIRE_TOKEN=

# ---------------------------------------------------------------------------
# GitHub token (only for local scripts that call the GitHub API; the Action uses
# the workflow's job token)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Contributor knobs (read by the test runner and Makefile, not by the product)
# ---------------------------------------------------------------------------
# Disable or size pytest-xdist parallelism (0 disables).
# MERGECRAFT_PYTEST_JOBS=
# Pin the random seed for deterministic test ordering.
# MERGECRAFT_PYTEST_RANDOM_SEED=
# Skip pre-commit for one-shot scripted commits.
# MERGECRAFT_SKIP_PRECOMMIT=
# Number of CI test shards.
# MERGECRAFT_TEST_SPLITS=
# Which CI test shard to run.
# MERGECRAFT_TEST_GROUP=
